import java.util.*;
import java.io.IOException;
import java.io.FileReader;
import java.io.FileWriter;

public class Main {
    public static void main(String[] args) {
      try(
        FileReader reader = new FileReader ("Source.text");
        FileWriter write = new FileWriter("Copy.text");
      ){
        int ch;

        while ((ch = reader.read()) != -1 ) { 
          writer.write(ch);

        }
        System.out.println("File copied succesfully.");

      }catch (IOException e ){
        System.out.println("file opperation failed.");
      }
    }
}
